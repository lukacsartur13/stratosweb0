{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Claude Design — three-layer design tokens. Layer 1 primitives are raw values and are never used directly in product code. Layer 2 semantics name intent and are what components consume. Layer 3 component tokens exist only where a component needs a value no semantic token can honestly describe.",
  "$version": "1.0.0",

  "primitive": {
    "color": {
      "$description": "Raw ramps. Never reference these from a component.",

      "clay": {
        "$description": "The signature warm accent. 500 is the brand anchor.",
        "50":  { "$value": "#FBF0EC", "$type": "color" },
        "100": { "$value": "#F6DFD6", "$type": "color" },
        "200": { "$value": "#EEC3B4", "$type": "color" },
        "300": { "$value": "#E5A38C", "$type": "color" },
        "400": { "$value": "#DE8C6F", "$type": "color" },
        "500": { "$value": "#D97757", "$type": "color" },
        "600": { "$value": "#C25F3F", "$type": "color" },
        "700": { "$value": "#A04B31", "$type": "color" },
        "800": { "$value": "#7B3A26", "$type": "color" },
        "900": { "$value": "#552718", "$type": "color" }
      },

      "ivory": {
        "$description": "Warm paper neutrals. The surface family in light mode.",
        "50":  { "$value": "#FEFDFB", "$type": "color" },
        "100": { "$value": "#FAF9F5", "$type": "color" },
        "200": { "$value": "#F5F3EE", "$type": "color" },
        "300": { "$value": "#F0EEE6", "$type": "color" },
        "400": { "$value": "#E8E5DA", "$type": "color" },
        "500": { "$value": "#DAD6C8", "$type": "color" },
        "600": { "$value": "#C2BDAC", "$type": "color" }
      },

      "ink": {
        "$description": "Warm-black neutrals. Text in light mode, surfaces in dark mode.",
        "50":  { "$value": "#8A8780", "$type": "color" },
        "100": { "$value": "#6F6C65", "$type": "color" },
        "200": { "$value": "#57544E", "$type": "color" },
        "300": { "$value": "#413F3A", "$type": "color" },
        "400": { "$value": "#302E2B", "$type": "color" },
        "500": { "$value": "#262625", "$type": "color" },
        "600": { "$value": "#1F1E1D", "$type": "color" },
        "700": { "$value": "#191817", "$type": "color" },
        "800": { "$value": "#141413", "$type": "color" },
        "900": { "$value": "#0D0D0C", "$type": "color" }
      },

      "sky": {
        "$description": "Cool secondary. Used for information states and data-viz series 2.",
        "100": { "$value": "#E3EDF3", "$type": "color" },
        "300": { "$value": "#A9C7D8", "$type": "color" },
        "500": { "$value": "#6A9BB8", "$type": "color" },
        "700": { "$value": "#3F6E8B", "$type": "color" },
        "900": { "$value": "#26445A", "$type": "color" }
      },

      "moss": {
        "$description": "Muted green. Success states and data-viz series 3.",
        "100": { "$value": "#E4EDE2", "$type": "color" },
        "300": { "$value": "#A9C4A2", "$type": "color" },
        "500": { "$value": "#6E9264", "$type": "color" },
        "700": { "$value": "#4A6A42", "$type": "color" },
        "900": { "$value": "#2C4127", "$type": "color" }
      },

      "amber": {
        "$description": "Caution. Deliberately distinct from clay so warnings never read as brand.",
        "100": { "$value": "#F8EBD2", "$type": "color" },
        "300": { "$value": "#EBC680", "$type": "color" },
        "500": { "$value": "#C8942B", "$type": "color" },
        "700": { "$value": "#946A17", "$type": "color" },
        "900": { "$value": "#5A400C", "$type": "color" }
      },

      "rose": {
        "$description": "Danger. Cooler and darker than clay to survive side-by-side use.",
        "100": { "$value": "#F9E3E1", "$type": "color" },
        "300": { "$value": "#E9A8A2", "$type": "color" },
        "500": { "$value": "#C4544A", "$type": "color" },
        "700": { "$value": "#96372F", "$type": "color" },
        "900": { "$value": "#5C1F1A", "$type": "color" }
      },

      "pure": {
        "white": { "$value": "#FFFFFF", "$type": "color" },
        "black": { "$value": "#000000", "$type": "color" }
      }
    },

    "font": {
      "family": {
        "sans": {
          "$value": "\"Styrene A\", \"Styrene B\", Söhne, Inter, \"Hanken Grotesk\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$description": "Styrene is licensed from Commercial Type and is not redistributed here. Inter is the shipped open fallback; see fonts/README.md."
        },
        "serif": {
          "$value": "\"Tiempos Text\", \"Source Serif 4\", Newsreader, Charter, \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
          "$type": "fontFamily",
          "$description": "Tiempos is licensed from Klim Type Foundry and is not redistributed here. Source Serif 4 is the shipped open fallback."
        },
        "mono": {
          "$value": "\"Berkeley Mono\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
          "$type": "fontFamily"
        }
      },
      "weight": {
        "regular":  { "$value": 400, "$type": "fontWeight" },
        "medium":   { "$value": 500, "$type": "fontWeight" },
        "semibold": { "$value": 600, "$type": "fontWeight" },
        "bold":     { "$value": 700, "$type": "fontWeight" }
      },
      "size": {
        "$description": "1.200 minor-third ramp anchored at 16px / 1rem.",
        "3xs": { "$value": "0.6875rem", "$type": "dimension" },
        "2xs": { "$value": "0.75rem",   "$type": "dimension" },
        "xs":  { "$value": "0.8125rem", "$type": "dimension" },
        "sm":  { "$value": "0.875rem",  "$type": "dimension" },
        "md":  { "$value": "1rem",      "$type": "dimension" },
        "lg":  { "$value": "1.125rem",  "$type": "dimension" },
        "xl":  { "$value": "1.25rem",   "$type": "dimension" },
        "2xl": { "$value": "1.5rem",    "$type": "dimension" },
        "3xl": { "$value": "1.875rem",  "$type": "dimension" },
        "4xl": { "$value": "2.25rem",   "$type": "dimension" },
        "5xl": { "$value": "3rem",      "$type": "dimension" },
        "6xl": { "$value": "3.75rem",   "$type": "dimension" },
        "7xl": { "$value": "4.5rem",    "$type": "dimension" }
      },
      "lineHeight": {
        "none":    { "$value": 1,    "$type": "number" },
        "tight":   { "$value": 1.1,  "$type": "number" },
        "snug":    { "$value": 1.25, "$type": "number" },
        "normal":  { "$value": 1.5,  "$type": "number" },
        "relaxed": { "$value": 1.65, "$type": "number" },
        "loose":   { "$value": 1.8,  "$type": "number" }
      },
      "letterSpacing": {
        "tighter": { "$value": "-0.03em", "$type": "dimension" },
        "tight":   { "$value": "-0.015em", "$type": "dimension" },
        "normal":  { "$value": "0em",     "$type": "dimension" },
        "wide":    { "$value": "0.02em",  "$type": "dimension" },
        "wider":   { "$value": "0.06em",  "$type": "dimension" },
        "widest":  { "$value": "0.12em",  "$type": "dimension" }
      }
    },

    "space": {
      "$description": "4px base grid. Values are rem so they respond to root font size.",
      "0":  { "$value": "0rem",     "$type": "dimension" },
      "1":  { "$value": "0.25rem",  "$type": "dimension" },
      "2":  { "$value": "0.5rem",   "$type": "dimension" },
      "3":  { "$value": "0.75rem",  "$type": "dimension" },
      "4":  { "$value": "1rem",     "$type": "dimension" },
      "5":  { "$value": "1.25rem",  "$type": "dimension" },
      "6":  { "$value": "1.5rem",   "$type": "dimension" },
      "8":  { "$value": "2rem",     "$type": "dimension" },
      "10": { "$value": "2.5rem",   "$type": "dimension" },
      "12": { "$value": "3rem",     "$type": "dimension" },
      "16": { "$value": "4rem",     "$type": "dimension" },
      "20": { "$value": "5rem",     "$type": "dimension" },
      "24": { "$value": "6rem",     "$type": "dimension" },
      "32": { "$value": "8rem",     "$type": "dimension" }
    },

    "radius": {
      "none": { "$value": "0rem",     "$type": "dimension" },
      "xs":   { "$value": "0.25rem",  "$type": "dimension" },
      "sm":   { "$value": "0.375rem", "$type": "dimension" },
      "md":   { "$value": "0.5rem",   "$type": "dimension" },
      "lg":   { "$value": "0.75rem",  "$type": "dimension" },
      "xl":   { "$value": "1rem",     "$type": "dimension" },
      "2xl":  { "$value": "1.5rem",   "$type": "dimension" },
      "full": { "$value": "9999px",   "$type": "dimension" }
    },

    "shadow": {
      "$description": "Warm-tinted shadows. A neutral grey shadow reads as dirt against ivory surfaces.",
      "xs": { "$value": "0 1px 2px rgba(20, 20, 19, 0.06)", "$type": "shadow" },
      "sm": { "$value": "0 1px 3px rgba(20, 20, 19, 0.08), 0 1px 2px rgba(20, 20, 19, 0.04)", "$type": "shadow" },
      "md": { "$value": "0 4px 12px rgba(20, 20, 19, 0.08), 0 1px 3px rgba(20, 20, 19, 0.05)", "$type": "shadow" },
      "lg": { "$value": "0 12px 28px rgba(20, 20, 19, 0.10), 0 2px 6px rgba(20, 20, 19, 0.05)", "$type": "shadow" },
      "xl": { "$value": "0 24px 56px rgba(20, 20, 19, 0.14), 0 4px 10px rgba(20, 20, 19, 0.06)", "$type": "shadow" }
    },

    "duration": {
      "instant": { "$value": "80ms",  "$type": "duration" },
      "fast":    { "$value": "140ms", "$type": "duration" },
      "base":    { "$value": "220ms", "$type": "duration" },
      "slow":    { "$value": "380ms", "$type": "duration" },
      "slower":  { "$value": "620ms", "$type": "duration" }
    },

    "easing": {
      "standard":  { "$value": "cubic-bezier(0.2, 0, 0, 1)",      "$type": "cubicBezier" },
      "entrance":  { "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)", "$type": "cubicBezier" },
      "exit":      { "$value": "cubic-bezier(0.3, 0, 0.8, 0.15)", "$type": "cubicBezier" },
      "emphasis":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1.4)",  "$type": "cubicBezier" }
    }
  },

  "semantic": {
    "$description": "What components consume. Every value here is an alias to a primitive, and every one has a dark-mode counterpart in tokens.css.",

    "surface": {
      "canvas":    { "$value": "{primitive.color.ivory.300}", "$type": "color", "$description": "The page itself." },
      "raised":    { "$value": "{primitive.color.ivory.100}", "$type": "color", "$description": "Cards, panels, anything sitting on canvas." },
      "overlay":   { "$value": "{primitive.color.ivory.50}",  "$type": "color", "$description": "Modals, popovers, menus." },
      "sunken":    { "$value": "{primitive.color.ivory.400}", "$type": "color", "$description": "Wells, code blocks, inset regions." },
      "inverse":   { "$value": "{primitive.color.ink.800}",   "$type": "color" },
      "accent":    { "$value": "{primitive.color.clay.500}",  "$type": "color" },
      "accentSubtle": { "$value": "{primitive.color.clay.50}", "$type": "color" },
      "scrim":     { "$value": "rgba(20, 20, 19, 0.42)",      "$type": "color" }
    },

    "text": {
      "primary":   { "$value": "{primitive.color.ink.800}", "$type": "color" },
      "secondary": { "$value": "{primitive.color.ink.200}", "$type": "color" },
      "tertiary":  { "$value": "{primitive.color.ink.100}", "$type": "color" },
      "disabled":  { "$value": "{primitive.color.ink.50}",  "$type": "color" },
      "inverse":   { "$value": "{primitive.color.ivory.100}", "$type": "color" },
      "accent":    { "$value": "{primitive.color.clay.700}", "$type": "color", "$description": "clay.700, not clay.500 — 500 fails 4.5:1 on ivory at body sizes." },
      "onAccent":  { "$value": "{primitive.color.pure.white}", "$type": "color" },
      "link":      { "$value": "{primitive.color.clay.700}", "$type": "color" }
    },

    "border": {
      "subtle":   { "$value": "{primitive.color.ivory.500}", "$type": "color" },
      "default":  { "$value": "{primitive.color.ivory.600}", "$type": "color" },
      "strong":   { "$value": "{primitive.color.ink.100}",   "$type": "color" },
      "accent":   { "$value": "{primitive.color.clay.500}",  "$type": "color" },
      "focus":    { "$value": "{primitive.color.clay.600}",  "$type": "color" }
    },

    "status": {
      "info":    { "$value": "{primitive.color.sky.700}",   "$type": "color" },
      "success": { "$value": "{primitive.color.moss.700}",  "$type": "color" },
      "warning": { "$value": "{primitive.color.amber.700}", "$type": "color" },
      "danger":  { "$value": "{primitive.color.rose.700}",  "$type": "color" },
      "infoSurface":    { "$value": "{primitive.color.sky.100}",   "$type": "color" },
      "successSurface": { "$value": "{primitive.color.moss.100}",  "$type": "color" },
      "warningSurface": { "$value": "{primitive.color.amber.100}", "$type": "color" },
      "dangerSurface":  { "$value": "{primitive.color.rose.100}",  "$type": "color" }
    },

    "chart": {
      "$description": "Ordered categorical series. Distinguishable in both themes and under deuteranopia.",
      "series1": { "$value": "{primitive.color.clay.500}", "$type": "color" },
      "series2": { "$value": "{primitive.color.sky.700}",  "$type": "color" },
      "series3": { "$value": "{primitive.color.moss.500}", "$type": "color" },
      "series4": { "$value": "{primitive.color.amber.500}", "$type": "color" },
      "series5": { "$value": "{primitive.color.ink.200}",  "$type": "color" },
      "series6": { "$value": "{primitive.color.sky.300}",  "$type": "color" },
      "grid":    { "$value": "{primitive.color.ivory.500}", "$type": "color" },
      "axis":    { "$value": "{primitive.color.ink.100}",  "$type": "color" }
    },

    "typography": {
      "display": {
        "$description": "Serif. Marketing headlines and empty-state hero copy only — never UI chrome.",
        "$value": {
          "fontFamily": "{primitive.font.family.serif}",
          "fontWeight": "{primitive.font.weight.regular}",
          "fontSize": "{primitive.font.size.6xl}",
          "lineHeight": "{primitive.font.lineHeight.tight}",
          "letterSpacing": "{primitive.font.letterSpacing.tight}"
        },
        "$type": "typography"
      },
      "heading1": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontWeight": "{primitive.font.weight.semibold}",
          "fontSize": "{primitive.font.size.4xl}",
          "lineHeight": "{primitive.font.lineHeight.tight}",
          "letterSpacing": "{primitive.font.letterSpacing.tight}"
        },
        "$type": "typography"
      },
      "heading2": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontWeight": "{primitive.font.weight.semibold}",
          "fontSize": "{primitive.font.size.2xl}",
          "lineHeight": "{primitive.font.lineHeight.snug}",
          "letterSpacing": "{primitive.font.letterSpacing.tight}"
        },
        "$type": "typography"
      },
      "heading3": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontWeight": "{primitive.font.weight.semibold}",
          "fontSize": "{primitive.font.size.lg}",
          "lineHeight": "{primitive.font.lineHeight.snug}",
          "letterSpacing": "{primitive.font.letterSpacing.normal}"
        },
        "$type": "typography"
      },
      "body": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontWeight": "{primitive.font.weight.regular}",
          "fontSize": "{primitive.font.size.md}",
          "lineHeight": "{primitive.font.lineHeight.relaxed}",
          "letterSpacing": "{primitive.font.letterSpacing.normal}"
        },
        "$type": "typography"
      },
      "bodyProse": {
        "$description": "Long-form reading. Serif, wider leading, capped at 68ch.",
        "$value": {
          "fontFamily": "{primitive.font.family.serif}",
          "fontWeight": "{primitive.font.weight.regular}",
          "fontSize": "{primitive.font.size.lg}",
          "lineHeight": "{primitive.font.lineHeight.loose}",
          "letterSpacing": "{primitive.font.letterSpacing.normal}"
        },
        "$type": "typography"
      },
      "label": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontWeight": "{primitive.font.weight.medium}",
          "fontSize": "{primitive.font.size.sm}",
          "lineHeight": "{primitive.font.lineHeight.normal}",
          "letterSpacing": "{primitive.font.letterSpacing.normal}"
        },
        "$type": "typography"
      },
      "caption": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontWeight": "{primitive.font.weight.regular}",
          "fontSize": "{primitive.font.size.xs}",
          "lineHeight": "{primitive.font.lineHeight.normal}",
          "letterSpacing": "{primitive.font.letterSpacing.normal}"
        },
        "$type": "typography"
      },
      "eyebrow": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontWeight": "{primitive.font.weight.medium}",
          "fontSize": "{primitive.font.size.2xs}",
          "lineHeight": "{primitive.font.lineHeight.normal}",
          "letterSpacing": "{primitive.font.letterSpacing.widest}",
          "textTransform": "uppercase"
        },
        "$type": "typography"
      },
      "code": {
        "$value": {
          "fontFamily": "{primitive.font.family.mono}",
          "fontWeight": "{primitive.font.weight.regular}",
          "fontSize": "{primitive.font.size.sm}",
          "lineHeight": "{primitive.font.lineHeight.normal}",
          "letterSpacing": "{primitive.font.letterSpacing.normal}"
        },
        "$type": "typography"
      }
    }
  },

  "component": {
    "$description": "Only where a semantic token cannot honestly describe the value.",
    "button": {
      "heightSm": { "$value": "2rem",    "$type": "dimension" },
      "heightMd": { "$value": "2.5rem",  "$type": "dimension" },
      "heightLg": { "$value": "3rem",    "$type": "dimension" },
      "paddingInline": { "$value": "{primitive.space.4}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
    },
    "input": {
      "height": { "$value": "2.5rem", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
    },
    "card": {
      "padding": { "$value": "{primitive.space.6}", "$type": "dimension" },
      "radius":  { "$value": "{primitive.radius.xl}", "$type": "dimension" }
    },
    "focusRing": {
      "width":  { "$value": "2px", "$type": "dimension" },
      "offset": { "$value": "2px", "$type": "dimension" }
    },
    "layout": {
      "contentMax": { "$value": "72rem", "$type": "dimension" },
      "proseMax":   { "$value": "42rem", "$type": "dimension" },
      "gutter":     { "$value": "{primitive.space.6}", "$type": "dimension" }
    }
  }
}
