# =============================================================================
# Stratos — environment
#
# Copy to .env for local work. .env is gitignored; never commit real values.
#
# VITE_* variables are compiled INTO the browser bundle and are therefore
# public. Everything else stays server-side and must only ever be set in the
# Netlify UI (Site settings -> Environment variables), never in this file with
# a real value and never in the portal/ directory.
# =============================================================================

# --- public, safe to ship in the bundle --------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://media-stratos.com

# --- measurement, build time only --------------------------------------------
# Phase 9, Workstream C. Read by _build/build.py when the site is generated, so
# these belong in the BUILD environment (Netlify UI), not in a browser bundle.
#
# Leave ANALYTICS_ENDPOINT empty and the site ships no measurement whatsoever:
# no config block, no adapter script, no request, no bytes. That is the default
# and it is what keeps the site cookie-free and consent-free.
#
# The endpoint MUST be same-origin. The Content-Security-Policy in netlify.toml
# is `connect-src 'self' https://*.supabase.co`, so a third-party analytics URL
# cannot transmit under it — and widening that policy is a deliberate decision,
# not a configuration detail. No provider is chosen: the adapter posts a
# neutral envelope. See _build/reports/phase9-event-taxonomy.md.
ANALYTICS_ENDPOINT=
# Optional. Property identifier, echoed back on every event as `site`.
ANALYTICS_SITE=
# Optional. "1" holds events until Stratos.analytics.consent('granted').
# Only needed if measurement ever starts using cookies or storage; it does not
# today, which is why no consent banner is required.
ANALYTICS_CONSENT=
# Optional. "1" logs dropped events to the console.
ANALYTICS_DEBUG=

# NOTE: there is no VITE_ANALYTICS_ID. It was declared here and in README.md for
# a long time with no implementation behind it, and it could never have worked:
# VITE_* variables are compiled into the *portal's* Vite bundle, and the public
# site is static output from _build/build.py, which that bundle never touches.
# Setting it did nothing. The variables above are the real mechanism.

# --- server only. NEVER prefix these with VITE_ ------------------------------
# The key POST /api/lead uses to insert into `leads`. It bypasses RLS, so it is
# read only by netlify/functions/submit-lead.mjs and must exist only in the
# Netlify function environment. If it ever appears in a client bundle, in
# generated HTML, in netlify.toml or in this repository, rotate it immediately
# in the Supabase dashboard.
#
# Set ONE of these two. The function prefers the first:
#
#   SUPABASE_SECRET_KEY        the current Supabase secret-key model (sb_secret_…).
#                              Preferred: it is revocable on its own and is not a
#                              JWT that outlives a rotation.
#   SUPABASE_SERVICE_ROLE_KEY  the legacy service-role JWT. Still supported so an
#                              existing deployment keeps working; migrate to the
#                              secret key when the project is moved over.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project.supabase.co

# Salt for hashing submitter IP addresses before storing them. Any long random
# string. Changing it makes existing hashes uncomparable, which is fine.
IP_HASH_SALT=
