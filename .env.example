# =============================================================================
# Stratos — environment
#
# Copy to .env for local work. .env is gitignored; never commit real values.
#
# VITE_* variables are compiled INTO the browser bundle and are therefore
# public. Everything else stays server-side and must only ever be set in the
# Netlify UI (Site settings -> Environment variables), never in this file with
# a real value and never in the portal/ directory.
# =============================================================================

# --- public, safe to ship in the bundle --------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# The site's own origin. NOT media-stratos.com, which is the Wix site this
# project replaces — it was the example value here, and it is the exact value
# that was once hardcoded into every canonical on the site. See
# scripts/site-origin.mjs: leaving this unset resolves correctly on Netlify.
VITE_SITE_URL=https://stratosweb.hu

# --- measurement, build time only --------------------------------------------
# Phase 9, Workstream C. Read by _build/build.py when the site is generated, so
# these belong in the BUILD environment (Netlify UI), not in a browser bundle.
#
# THE PROVIDER IS GOOGLE ANALYTICS 4, and its Measurement ID is NOT here: it is
# a public identifier that ships in the page either way, so it lives in
# _build/build.py as GA4_MEASUREMENT_ID. Set GA4_MEASUREMENT_ID here only to
# point a build at a different property.
#
# GA4 cannot run just because it is configured. It also requires:
#   * the visitor's explicit consent — the tag is not loaded before it; and
#   * a hostname on GA4_ALLOWED_HOSTS in _build/build.py.
# So a local build, a deploy preview or a fork measures nothing, whatever is
# set here.
#
# The numeric GA4 PROPERTY ID (15392224433) belongs to the Portal's server-side
# Analytics Data API integration and must never appear in a browser bundle or
# in the generated site.
GA4_MEASUREMENT_ID=

# Optional first-party sink. This is the provider-neutral seam the adapter is
# built around — NOT the production measurement solution, and there is no
# endpoint implementation behind it. If set, it must be same-origin: the CSP
# allows `connect-src 'self'` plus Google and Supabase, and nothing else.
ANALYTICS_ENDPOINT=
# Optional. Property identifier, echoed back on every event as `site`.
ANALYTICS_SITE=
# Optional, and redundant while GA4 is the provider: configuring GA4 forces
# consent on by itself, because GA4 sets cookies. Kept for a future provider
# that does not.
ANALYTICS_CONSENT=
# Optional. "1" logs dropped events to the console.
ANALYTICS_DEBUG=

# NOTE: there is no VITE_ANALYTICS_ID. It was declared here and in README.md for
# a long time with no implementation behind it, and it could never have worked:
# VITE_* variables are compiled into the *portal's* Vite bundle, and the public
# site is static output from _build/build.py, which that bundle never touches.
# Setting it did nothing. The variables above are the real mechanism.

# --- server only. NEVER prefix these with VITE_ ------------------------------
# The key POST /api/lead uses to insert into `leads`. It bypasses RLS, so it is
# read only by netlify/functions/submit-lead.mjs and must exist only in the
# Netlify function environment. If it ever appears in a client bundle, in
# generated HTML, in netlify.toml or in this repository, rotate it immediately
# in the Supabase dashboard.
#
# Set ONE of these two. The function prefers the first:
#
#   SUPABASE_SECRET_KEY        the current Supabase secret-key model (sb_secret_…).
#                              Preferred: it is revocable on its own and is not a
#                              JWT that outlives a rotation.
#   SUPABASE_SERVICE_ROLE_KEY  the legacy service-role JWT. Still supported so an
#                              existing deployment keeps working; migrate to the
#                              secret key when the project is moved over.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project.supabase.co

# Salt for hashing submitter IP addresses before storing them. Any long random
# string. Changing it makes existing hashes uncomparable, which is fine.
IP_HASH_SALT=

# --- Portal Analytics. Server only, and the private key is a real secret ------
# Phase 9, Workstream M. Read ONLY by netlify/functions/portal-analytics.mjs,
# which is the one place the GA4 Data API is called from.
#
# These are for REPORTING and are a different system from the measurement tag on
# the public site. The site measures with the GA4 Measurement ID, which is
# public and ships in the page; the Portal reports with the numeric Property ID
# plus the service-account credentials below, which must never appear in a
# browser bundle, in generated HTML, in netlify.toml or in this repository.
# `tests/portal-analytics.spec.ts` asserts the built portal bundle carries none
# of them.
#
# With any of the three unset the endpoint answers 200 with
# `configured: false` and the Portal renders a setup screen. That is a supported
# state, not a broken one — nothing else in the portal is affected.
#
# Setup sequence, and the step that gets missed, are in
# _build/reports/phase9-portal-analytics.md.

# The NUMERIC property id — Admin -> Property Settings. Not the G-XXXX
# Measurement ID, which is a different identifier for a different job.
GA4_PROPERTY_ID=

# The service account's address, from the JSON key file's `client_email`.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key, from the JSON key file's `private_key`.
# A REAL SECRET: anyone holding it can read the property. Paste it exactly as
# the JSON file has it, including the literal \n escapes — the function converts
# them. Set it in the Netlify UI only, scoped to Functions, and never here.
GOOGLE_PRIVATE_KEY=
