# Copy to .env (gitignored) for local runs. For EAS builds, set the same three
# as EAS environment variables. All three are public: the anon key ships in the
# Portal's own bundle too, and RLS decides what any token may read.
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<the Portal's VITE_SUPABASE_ANON_KEY>
# Where /api/widget lives. Defaults to https://stratosweb.hu when unset.
EXPO_PUBLIC_API_ORIGIN=https://stratosweb.hu
