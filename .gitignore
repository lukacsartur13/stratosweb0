node_modules/
dist/
.env
.env.local
.env.*.local

# Playwright
test-results/
playwright-report/
blob-report/
.playwright-mcp/
*.jpeg

# Evaluation stills for the 3D prototype. Regenerated by
# `npm run test:experiments`, so they are output, not source.
experiments/screenshots/

# Raw benchmark JSON. Same reasoning: it is a measurement, reproducible with
# `npm run bench:meridian`, and it is machine-specific — the numbers worth
# keeping are transcribed into MERIDIAN_PERFORMANCE_AUDIT.md with the hardware
# they were taken on.
experiments/bench-out/

# Blender writes a .blend1 alongside the source on every save.
*.blend1

# Local backups of the pre-rework site. Kept out of the repo on purpose: it is
# a point-in-time safety net, not history — git already has that.
_backup/

.DS_Store

# iCloud Drive conflict duplicates. Syncing this folder from more than one
# place makes copies named "thing 2.ext" alongside the original. They are never
# source, and committing one is actively harmful: a stray
# "netlify/functions/submit-lead 2.mjs" would deploy as a second function.
* [0-9].*
* [0-9][0-9].*

# Sharded output from `validate-meridian.mjs`, joined into
# meridian-visibility.json by `merge-meridian.mjs`. Intermediate, per-run.
_build/reports/shards/

# Review imagery under _build/reports/. The written reports are the deliverable
# and are kept; the stills they cite are regenerable output, and by Phase 9 they
# had reached 246 MB in the working tree. _build/reports/ is otherwise a tracked
# directory, so without this a single `git add -A` commits all of it.
#
# Findings belong in the .md; a screenshot is the evidence you looked at, not
# the record. Anything genuinely worth keeping can be force-added.
_build/reports/**/*.png
_build/reports/*-shots/
# The same rule for the recordings the temporal reviews cite. No .webm under
# _build/reports/ has ever been tracked — but nothing said so, and one review
# package's natural-scroll captures are 35 MB, which a single `git add -A`
# would have committed. Same reasoning as the stills: regenerable, and the
# finding is what the .md says about them.
_build/reports/**/*.webm
# And the same for a review package's raw per-sample dumps. `probe-*.mjs` beside
# the report regenerates them in seconds, every figure they contain is quoted in
# the .md, and nothing reads them — unlike the audit JSON at the top of
# _build/reports/, which the `--check` gates do read and which stays tracked.
# This one package's dumps were 61 000 lines.
_build/reports/*-repair/*.json

# Review packages: the imagery is ignored, the writing is not.
#
# Phase 7's and Phase 8's packages ARE imagery — a few hundred screenshots each
# — so they stay ignored wholesale by the two explicit lines below. Phase 9's is
# text: §23 of its brief asks for a written review package and §24 forbids
# committing review MEDIA, which is a different thing. The three lines here
# ignore everything inside a review directory except directories and markdown,
# so a .md deliverable is tracked and a .png dropped beside it still is not.
#
# The directory itself is deliberately not ignored — git does not descend into
# an ignored directory, so a negation inside one never takes effect.
_build/reports/*-review/**
!_build/reports/*-review/**/
!_build/reports/*-review/**/*.md
_build/reports/phase7-review/
_build/reports/phase8-review/

# TypeScript incremental build cache. Machine-specific, rewritten on every
# typecheck, and meaningless to anyone else's checkout.
*.tsbuildinfo

# The mock-credential Portal bundle built by scripts/portal-shots.mjs. It exists
# so the review captures can show a populated dashboard; it is never published,
# is not `dist/`, and is rebuilt from scratch on every run.
_build/.portal-mock/

# Ad-hoc probe scripts. Every investigation in this repo leaves a few behind —
# `.tmp-mhf-drift.mjs`, `.tmp-ovf.mjs` — written to answer one question against
# a running page and never read again. By Phase 9 there were 113 of them. They
# are the working, not the work; the finding they produced is in the report.
.tmp-*

# Per-run Playwright JSON from the regression harness. The written reports
# beside it are the deliverable and stay tracked; this one records the argv and
# absolute paths of whichever machine last ran the suite, so it conflicts on
# every run and means nothing to another checkout.
_build/reports/regression-harness/last-run.json

# Failure artefacts captured by the navigation-boundary harness: a screenshot,
# a DOM dump, a network log and a timeline per failing test. Same reasoning as
# the review imagery above — regenerable evidence, not the record. The .png
# rule already excluded the stills; this covers the JSON beside them, which was
# 168 files.
_build/reports/**/failures/
