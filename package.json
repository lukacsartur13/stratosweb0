{
  "name": "stratos-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stratos Media — static trilingual public site plus the private React portal.",
  "scripts": {
    "postinstall": "npm ci --prefix portal",
    "generate": "python3 _build/build.py",
    "build:site": "node scripts/assemble.mjs",
    "build:portal": "npm --prefix portal run build",
    "build": "npm run generate && npm run build:site && npm run llms && npm run build:portal && npm run strip:comments && npm run fingerprint && npm run fonts:check",
    "fonts:check": "node scripts/font-coverage.mjs",
    "fingerprint": "node scripts/fingerprint-assets.mjs",
    "fingerprint:check": "node scripts/fingerprint-assets.mjs --check",
    "dev": "python3 -m http.server 4321",
    "dev:portal": "npm --prefix portal run dev",
    "typecheck": "npm --prefix portal run typecheck",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "audit:conversion": "node scripts/conversion-audit.mjs",
    "audit:conversion:check": "node scripts/conversion-audit.mjs --check",
    "audit:seo": "node scripts/seo-audit.mjs",
    "audit:seo:check": "node scripts/seo-audit.mjs --check",
    "audit:ownership": "node scripts/seo-ownership.mjs",
    "audit:ownership:check": "node scripts/seo-ownership.mjs --check",
    "serve:dist": "python3 -m http.server 4322 --directory dist",
    "llms": "node scripts/llms-txt.mjs",
    "strip:comments": "node scripts/strip-html-comments.mjs",
    "test:documents": "playwright test tests/portal-documents.spec.ts tests/portal-documents-db.spec.ts --project=desktop-1440",
    "check:documents:ui": "node scripts/portal-documents-check.mjs",
    "check:documents:live": "node scripts/documents-live-check.mjs",
    "test:client-portal": "playwright test tests/portal-client-db.spec.ts tests/portal-invite.spec.ts --project=desktop-1440",
    "check:client-portal:ui": "node scripts/portal-client-check.mjs",
    "check:client-portal:live": "node scripts/client-portal-live-check.mjs",
    "test:payments": "playwright test tests/portal-payments.spec.ts tests/portal-payments-db.spec.ts --project=node",
    "check:pg:integration": "node scripts/pg-integration-check.mjs",
    "check:release:local": "node scripts/local-supabase-release.mjs",
    "check:portal:live-browser": "node scripts/portal-live-browser-check.mjs"
  },
  "comments": {
    "dependencies": "Runtime dependencies of the NETLIFY FUNCTIONS, and nothing else. The public site ships no third-party JavaScript and the portal has its own manifest; this block exists because Netlify bundles netlify/functions/* against the ROOT package.json, not against portal/. Omitting @supabase/supabase-js here is what made every lead submission crash with ERR_MODULE_NOT_FOUND at the store step — the SDK was installed under portal/node_modules, where the function cannot reach it."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.25.12"
  }
}
